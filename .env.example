# ============================================================
#  LeadGen Pro — API Keys Configuration
#  Copy this file to .env and fill in what you have.
#  The tool works with ZERO keys (uses free scraping).
#  Each key you add unlocks a better data source.
# ============================================================

# ─── TIER 1: No signup needed (always on) ────────────────────
# OpenStreetMap Overpass API — no key needed ✓
# JustDial HTML scraping — no key needed ✓
# IndiaMART HTML scraping — no key needed ✓
# Google News RSS — no key needed ✓

# ─── TIER 2: Free signup, no credit card ─────────────────────

# Serper.dev — Google Maps data (2,500 FREE searches/month)
# Sign up: https://serper.dev (takes 30 seconds)
SERPER_API_KEY=

# ─── TIER 3: Free account required ───────────────────────────

# YouTube Data API v3 (10,000 FREE units/day)
# Get key: console.cloud.google.com → Create Project → Enable "YouTube Data API v3" → Create API Key
YOUTUBE_API_KEY=

# Meta (Facebook/Instagram) Access Token
# Get free token: https://developers.facebook.com/tools/explorer/
# Permissions needed: ads_read, pages_read_engagement
# Unlocks: Meta Ads Library + Facebook Pages + Instagram posts
META_ACCESS_TOKEN=

# ─── TIER 4: Optional paid (but has free tier) ───────────────

# Apify Token ($5 FREE credit/month — renews monthly!)
# Sign up: https://apify.com → Account → Integrations → API Token
# Unlocks: Reliable JustDial + IndiaMART actor data
APIFY_TOKEN=
